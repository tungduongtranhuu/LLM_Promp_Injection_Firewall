# Copy to .env (never commit .env). Every value below is the default.

# Ollama runs on the host (WSL), not in docker-compose
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=120

# RAG
RAG_MODE=normal            # normal | degraded | maintenance
RAG_TOP_K=4
CORPUS_PATH=data/corpus
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=acme_kb
QUARANTINE_PATH=quarantine

# Firewall thresholds (defaults come from app/scoring/rules.py)
# WARN_THRESHOLD=31
# BLOCK_THRESHOLD=50

AUDIT_LOG_PATH=logs/firewall.jsonl
LOG_LEVEL=INFO
